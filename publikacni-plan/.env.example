# Firebase projekt (výchozí hodnoty v src/config.ts míří na projekt "publikacni-plan")
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=

# Firemní domény, které se smí přihlásit (čárkami). Musí odpovídat firestore.rules.
VITE_ALLOWED_DOMAINS=ruzovyslon.cz

# Lokální vývoj proti emulátorům (npm run emulators + npm run dev:emulators)
# VITE_USE_EMULATORS=true
