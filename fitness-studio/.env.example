# --- povinné v produkci ---------------------------------------------------
# PostgreSQL (doporučeno Neon – https://neon.tech, region Frankfurt)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# náhodný řetězec min. 32 znaků: `openssl rand -base64 32`
AUTH_SECRET=
# veřejná adresa webu (pro odkazy v e-mailech a návrat z platby)
NEXT_PUBLIC_SITE_URL=https://www.octopushstudio.cz

# --- platby (Stripe) -------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# jen pro testování bez Stripe na produkčním buildu
# ALLOW_TEST_PAYMENTS=true

# --- e-maily (Resend) ------------------------------------------------------
RESEND_API_KEY=re_...
MAIL_FROM="OCTOPUSH <rezervace@octopushstudio.cz>"

# --- ostatní --------------------------------------------------------------
# chrání /api/cron (Vercel ho posílá automaticky)
CRON_SECRET=
# první admin účet při `npm run db:seed`
ADMIN_EMAIL=admin@octopushstudio.cz
ADMIN_PASSWORD=
