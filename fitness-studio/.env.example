# --- povinné v produkci ---------------------------------------------------
# PostgreSQL – Vercel/Neon: connection string; vlastní server: nech prázdné (nastaví compose.yaml)
DATABASE_URL=
# náhodný řetězec min. 32 znaků: `openssl rand -base64 32`
AUTH_SECRET=
# veřejná adresa webu (pro odkazy v e-mailech a návrat z platby)
SITE_URL=https://octopush.fit

# --- vlastní server (compose.yaml) ------------------------------------------
DOMAIN=octopush.fit
POSTGRES_PASSWORD=
# při startu serveru aplikuje migrace a založí admina (v Dockeru zapnuto samo)
# MIGRATE_ON_START=true

# --- platby (Stripe) -------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# jen pro testování bez Stripe na produkčním buildu
# ALLOW_TEST_PAYMENTS=true

# --- e-maily (Resend) ------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM="OCTOPUSH <rezervace@octopush.fit>"

# --- SMS: SMSbrána.cz (SMS Connect) – má přednost, když je vyplněná ------------
# login a heslo z administrace smsbrana.cz → Nastavení → SMS Connect
SMSBRANA_LOGIN=
SMSBRANA_PASSWORD=

# --- SMS (BulkGate – https://www.bulkgate.com, česká SMS brána) ------------
BULKGATE_APP_ID=
BULKGATE_APP_TOKEN=
# schválený text odesílatele (max 11 znaků), jinak se posílá ze systémového čísla
BULKGATE_SENDER=OCTOPUSH

# --- WhatsApp Business Platform (Meta Cloud API) ----------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- ostatní --------------------------------------------------------------
# chrání /api/cron (Vercel ho posílá automaticky; na vlastním serveru povinné)
CRON_SECRET=
# první admin účet při `npm run db:seed`
ADMIN_EMAIL=admin@octopush.fit
ADMIN_PASSWORD=
# testovací nasazení: naplnit demo data při buildu (jen do prázdné DB)
# SEED_DEMO=true

# --- Cloudflare Turnstile (ochrana registrace proti botům) ------------------
# dash.cloudflare.com → Turnstile → Add widget (doména octopush.fit); bez klíčů vypnuto
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
